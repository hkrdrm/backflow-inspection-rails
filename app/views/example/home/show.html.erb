<% @page_title = "Example Module" %>

<div class="space-y-6">
  <div>
    <h1 class="text-2xl font-bold text-navy">Overview</h1>
    <p class="mt-1 text-sm text-navy/70">
      This is the template module. Copy it to start a new one; see <code>docs/modules.md</code>.
    </p>
  </div>

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <%= link_to example_items_path, class: "block rounded-2xl border border-line bg-white p-5 transition hover:border-brand hover:shadow-sm" do %>
      <div class="text-sm font-semibold text-navy/70">Items</div>
      <div class="mt-2 text-3xl font-bold text-navy"><%= @item_count %></div>
    <% end %>
  </div>
</div>
