<% @page_title = "New item" %>

<div>
  <h1 class="text-2xl font-bold text-navy">New item</h1>

  <%= form_with model: @item, url: example_items_path, method: :post, scope: :item,
        class: "mt-6 max-w-xl rounded-2xl border border-line bg-white p-6" do |f| %>
    <% if @item.errors.any? %>
      <div class="mb-4 rounded-xl border border-danger/30 bg-danger/10 p-4 text-sm font-semibold text-danger">
        <ul class="list-disc pl-4">
          <% @item.errors.each do |field, messages| %>
            <% Array(messages).each do |message| %>
              <li><%= "#{field.to_s.humanize} #{message}" %></li>
            <% end %>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-4">
      <%= f.label :name, class: "block text-sm font-semibold text-navy" %>
      <%= f.text_field :name, class: "mt-1 w-full rounded-xl border border-line px-3 py-2 focus:border-brand focus:outline-none" %>
    </div>

    <div class="mb-4">
      <%= f.label :notes, class: "block text-sm font-semibold text-navy" %>
      <%= f.text_area :notes, rows: 3, class: "mt-1 w-full rounded-xl border border-line px-3 py-2 focus:border-brand focus:outline-none" %>
    </div>

    <div class="flex items-center gap-4">
      <%= f.submit "Add item", class: "cursor-pointer rounded-xl bg-brand px-5 py-3 text-sm font-bold text-white shadow-sm hover:bg-brand-dark" %>
      <%= link_to "Cancel", example_items_path, class: "text-sm font-semibold text-navy/70 hover:text-navy" %>
    </div>
  <% end %>
</div>
