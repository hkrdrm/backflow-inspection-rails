<% @page_title = "Dashboard" %>
<%# Core landing page for every tenant, whatever modules it has. It holds no
    module content of its own: each module's home page is linked from here. %>
<% modules = current_tenant.enabled_modules %>
<%# Modules the platform has marked planned: shown so tenants see what's
    coming, but not links, since they can't be used yet. %>
<% coming_soon = PlatformModule.planned_modules %>

<div class="mx-auto max-w-7xl space-y-6">
  <div>
    <h1 class="text-2xl font-bold text-navy">
      Welcome back, <%= current_account.email.split("@").first.capitalize %>.
    </h1>
    <p class="mt-1 text-sm text-muted"><%= current_tenant.name %> · <%= current_account.email %></p>
  </div>

  <% if modules.empty? %>
    <div class="rounded-2xl border border-line bg-white px-5 py-10 text-center text-sm text-muted">
      No modules are set up for your organization yet. Contact support to get started.
    </div>
  <% else %>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% modules.each do |definition| %>
        <%= link_to public_send(definition.home_path),
              class: "block rounded-2xl border border-line bg-white p-5 transition hover:border-brand hover:shadow-sm" do %>
          <div class="text-base font-bold text-navy"><%= definition.name %></div>
          <p class="mt-1 text-sm text-muted"><%= definition.description %></p>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <% if coming_soon.any? %>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% coming_soon.each do |definition| %>
        <div data-coming-soon class="rounded-2xl border border-dashed border-line bg-white/60 p-5">
          <div class="flex items-center justify-between gap-2">
            <div class="text-base font-bold text-navy/70"><%= definition.name %></div>
            <span class="rounded-full bg-warn/25 px-2.5 py-0.5 text-xs font-semibold text-warn-strong">Coming soon</span>
          </div>
          <p class="mt-1 text-sm text-navy/60"><%= definition.description %></p>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
