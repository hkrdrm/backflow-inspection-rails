<div class="bg-white text-ink">

  <%# ---------- Hero ---------- %>
  <section class="max-w-7xl mx-auto px-6 pt-12 pb-16 md:pt-16">
    <div class="max-w-2xl">
      <h1 class="font-display text-5xl md:text-6xl leading-[0.95] tracking-tight">
        <span class="block text-black">YOUR HEADLINE</span>
        <span class="block text-brand-green">GOES HERE.</span>
      </h1>

      <p class="mt-6 text-lg text-gray-700">
        A short sentence describing what this application does and who it is for.
      </p>

      <ul class="mt-6 space-y-3 font-bold text-sm md:text-base">
        <li class="flex items-center gap-3">
          <%= render "shared/check_icon" %>
          <span>First selling point</span>
        </li>
        <li class="flex items-center gap-3">
          <%= render "shared/check_icon" %>
          <span>Second selling point</span>
        </li>
        <li class="flex items-center gap-3">
          <%= render "shared/check_icon" %>
          <span>Third selling point</span>
        </li>
      </ul>

      <div class="mt-8 flex items-center gap-6 flex-wrap">
        <%= link_to rodauth.create_account_path, class: "inline-flex items-center gap-2 bg-brand-green hover:bg-brand-green-dark text-white font-bold text-sm tracking-wide uppercase px-6 py-3 rounded" do %>
          Get Started <span aria-hidden="true">&rarr;</span>
        <% end %>
        <%= link_to about_path, class: "inline-flex items-center gap-2 font-bold text-sm tracking-wide uppercase underline decoration-2 underline-offset-4 text-brand-green" do %>
          Learn More <span aria-hidden="true">&rarr;</span>
        <% end %>
      </div>
    </div>
  </section>

  <%= render "shared/section_divider" %>

  <%# ---------- Feature strip ---------- %>
  <section class="bg-white">
    <div class="max-w-7xl mx-auto px-6 py-10 grid sm:grid-cols-2 md:grid-cols-3 gap-8">
      <div class="flex items-start gap-4">
        <%= render "shared/feature_icon", icon: :bolt %>
        <div>
          <div class="font-bold text-sm uppercase tracking-wide">Feature One</div>
          <p class="text-sm text-gray-600 mt-1">A sentence or two about what this feature does for the user.</p>
        </div>
      </div>
      <div class="flex items-start gap-4">
        <%= render "shared/feature_icon", icon: :droplet %>
        <div>
          <div class="font-bold text-sm uppercase tracking-wide">Feature Two</div>
          <p class="text-sm text-gray-600 mt-1">A sentence or two about what this feature does for the user.</p>
        </div>
      </div>
      <div class="flex items-start gap-4">
        <%= render "shared/feature_icon", icon: :pin %>
        <div>
          <div class="font-bold text-sm uppercase tracking-wide">Feature Three</div>
          <p class="text-sm text-gray-600 mt-1">A sentence or two about what this feature does for the user.</p>
        </div>
      </div>
    </div>
  </section>

  <%= render "shared/section_divider" %>

  <%# ---------- Closing call to action ---------- %>
  <section class="max-w-7xl mx-auto px-6 py-12">
    <div class="max-w-2xl">
      <h2 class="font-display text-2xl">
        A CLOSING PROMPT <span class="block text-brand-green">FOR THE VISITOR</span>
      </h2>
      <p class="mt-4 text-sm text-gray-700">
        Replace this block with whatever the next step should be &mdash; a signup nudge, a summary, or a link into the app.
      </p>
      <div class="mt-6 flex gap-3">
        <%= link_to "About", about_path, class: "border-2 border-ink font-bold text-xs uppercase tracking-wide px-4 py-2 rounded" %>
        <%= link_to "Contact", contact_path, class: "border-2 border-brand-green text-brand-green font-bold text-xs uppercase tracking-wide px-4 py-2 rounded" %>
      </div>
    </div>
  </section>
</div>
