<div class="w-full flex flex-row justify-center m-8">
  <div class="bg-white border border-line p-8 flex flex-col gap-2 w-full max-w-md rounded-2xl shadow-sm" data-controller="issue">
    <% unless rodauth.login_form_footer_links.empty? %>
      <ul>
        <% rodauth.login_form_footer_links.sort.each do |_, link, text| %>
          <li><%= link_to text, link, class: "text-brand rounded-sm text-sm hover:underline hover:text-brand-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand" %></li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>
