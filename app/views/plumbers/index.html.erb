<% @page_title = "Plumbers" %>

<div class="mx-auto max-w-7xl space-y-6">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-navy">Plumbers</h1>
      <p class="mt-1 text-sm text-muted">Certified testers approved by <%= current_tenant.name %>.</p>
    </div>

    <%= link_to new_plumber_path,
          class: "inline-flex shrink-0 items-center gap-2 rounded-xl bg-brand px-5 py-3 text-sm font-bold text-white shadow-sm hover:bg-brand-dark" do %>
      <%= render "shared/icon", name: :plus, class: "size-5" %>
      New plumber
    <% end %>
  </div>

  <div class="rounded-2xl border border-line bg-white">
    <% if @plumbers.empty? %>
      <p class="px-5 py-10 text-center text-sm text-muted">No plumbers yet.</p>
    <% else %>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[720px] text-left text-sm">
          <thead>
            <tr class="text-xs uppercase tracking-wide text-muted">
              <th class="px-5 py-3 font-semibold">Name</th>
              <th class="px-5 py-3 font-semibold">Company</th>
              <th class="px-5 py-3 font-semibold">Cert number</th>
              <th class="px-5 py-3 font-semibold">Certification</th>
              <th class="px-5 py-3 font-semibold">Status</th>
              <th class="px-5 py-3"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody>
            <% @plumbers.each do |plumber| %>
              <tr class="border-t border-line">
                <td class="px-5 py-4 font-semibold text-navy"><%= plumber.name %></td>
                <td class="px-5 py-4 text-navy"><%= plumber.company_name %></td>
                <td class="px-5 py-4 text-muted"><%= plumber.cert_number %></td>
                <td class="px-5 py-4">
                  <% if plumber.cert_status == "verified" %>
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-ok-pale/50 px-3 py-1 text-xs font-semibold text-ok">
                      <%= render "shared/icon", name: :check, class: "size-3.5" %>
                      Verified
                    </span>
                  <% else %>
                    <span class="inline-flex items-center rounded-full bg-warn/25 px-3 py-1 text-xs font-semibold text-warn-strong">
                      <%= plumber.cert_status.capitalize %>
                    </span>
                  <% end %>
                </td>
                <td class="px-5 py-4">
                  <%= plumber.active? ? "Active" : "Inactive" %>
                </td>
                <td class="px-5 py-4">
                  <div class="flex items-center justify-end">
                    <%= link_to "Edit", edit_plumber_path(plumber),
                          class: "rounded-lg px-3 py-1.5 text-sm font-semibold text-brand hover:bg-tint" %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</div>
