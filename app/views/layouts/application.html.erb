<!DOCTYPE html>
<html>
  <head>
    <%= render "layouts/partials/head" %>
  </head>

  <%= render partial: "layouts/partials/navigation" %>

  <body class="flex flex-col bg-surface text-ink min-h-screen">
    <%= render "layouts/partials/impersonation_banner" %>

    <% if notice %>
      <div class="alert alert-success"><%= notice %></div>
    <% end %>
    <% if alert %>
      <div class="alert alert-danger"><%= alert %></div>
    <% end %>

    <div class="mb-auto">
      <%= yield %>
    </div>

    <footer class="relative overflow-hidden bg-navy text-white">
      <%= image_tag "wave-band.png", alt: "",
            class: "pointer-events-none absolute inset-x-0 bottom-0 w-full opacity-30 select-none" %>

      <div class="relative max-w-7xl mx-auto px-6 py-10 flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="text-lg font-bold tracking-wide">
          Protecting our water. <span class="text-sky">Protecting our community.</span>
        </div>

        <div class="flex flex-row items-center gap-6 text-xs font-bold tracking-widest uppercase text-sky-pale">
          <%= link_to "About", about_path %>
          <%= link_to "Contact", contact_path %>
        </div>

        <div class="text-xs text-sky-pale/70 shrink-0">
          &copy; <%= Date.current.year %> Backflow
        </div>
      </div>
    </footer>
  </body>
</html>
