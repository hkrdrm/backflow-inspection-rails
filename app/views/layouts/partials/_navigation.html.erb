<nav class="bg-white text-navy border-b border-line" data-controller="mobile-menu" data-action="turbo:load->mobile-menu#close">
  <div class="flex flex-row items-center justify-between gap-6 px-8 py-3 max-w-7xl mx-auto">
    <%= link_to root_path, class: "flex items-center shrink-0" do %>
      <%= image_tag "backflow-lockup.png", alt: "Backflow — clean water, safe community", class: "h-10 w-auto" %>
    <% end %>

    <div class="hidden md:flex flex-row items-center gap-8 font-bold text-sm tracking-wider uppercase">
      <%= link_to "Home", root_path %>
      <%= link_to "About", about_path %>
      <%= link_to "Contact", contact_path %>
    </div>

    <div class="flex items-center gap-4">
      <div class="hidden md:block">
        <%= render "layouts/partials/login_menu" %>
      </div>

      <button type="button" class="md:hidden shrink-0 p-2 -mr-2" data-action="click->mobile-menu#toggle" aria-label="Toggle menu" aria-expanded="false">
        <svg data-mobile-menu-target="openIcon" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg data-mobile-menu-target="closeIcon" class="hidden w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <div data-mobile-menu-target="menu" class="hidden md:hidden px-8 pb-4 font-bold text-sm tracking-wider uppercase">
    <%= link_to "Home", root_path, class: "block py-2 border-b border-line" %>
    <%= link_to "About", about_path, class: "block py-2 border-b border-line" %>
    <%= link_to "Contact", contact_path, class: "block py-2 border-b border-line" %>

    <div class="mt-4">
      <%= render "layouts/partials/login_menu" %>
    </div>
  </div>
</nav>
