<%#
  Sidebar for the signed-in app shell.

  Dashboard, then one link per module the tenant has, then Settings. A
  module's own pages are tabs inside the module (layouts/tenant_module), so
  the sidebar stays short however much a module contains. The module link is
  current on every page in that module. Items without a path render as inert
  entries rather than links to nowhere.
%>
<% module_items = Array(current_tenant&.enabled_modules).map do |definition|
     { label: definition.name, icon: definition.icon, path: public_send(definition.home_path),
       current: current_module&.key == definition.key }
   end %>
<% nav_items = [
     { label: "Dashboard", icon: :home, path: dashboard_path },
     *module_items,
     { label: "Settings", icon: :gear }
   ] %>
<%# The logo always needs somewhere safe to go: a tenant lands on their own
    dashboard, a super admin with no tenant lands in the back office, and a
    super admin who somehow has neither gets no link rather than a 404. %>
<% logo_path = if current_tenant
                 dashboard_path
               elsif current_account&.super_admin?
                 super_admin_root_path
               end %>

<aside class="flex h-full w-64 shrink-0 flex-col bg-white">
  <div class="px-5 py-6">
    <% if logo_path %>
      <%= link_to logo_path, class: "block" do %>
        <%= render "shared/logo", tone: :light %>
      <% end %>
    <% else %>
      <%= render "shared/logo", tone: :light %>
    <% end %>
  </div>

  <nav class="relative mx-3 mb-3 flex flex-1 flex-col overflow-hidden rounded-2xl bg-navy pt-4 text-sky-pale">
    <%= image_tag "contours.svg", alt: "",
          class: "pointer-events-none absolute inset-x-0 bottom-0 h-64 w-full object-cover opacity-30 select-none" %>

    <ul class="relative space-y-1 px-3">
      <% if current_tenant %>
        <% nav_items.each do |item| %>
          <li>
            <% if item[:path] %>
              <% active = item.fetch(:current) { current_page?(item[:path]) } %>
              <%= link_to item[:path],
                    "aria-current": (active ? "page" : nil),
                    class: "flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold transition #{active ? 'bg-brand text-white shadow-sm' : 'hover:bg-white/10 hover:text-white'}" do %>
                <%= render "shared/icon", name: item[:icon], class: "size-5 shrink-0" %>
                <%= item[:label] %>
              <% end %>
            <% else %>
              <span class="flex cursor-default items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold text-sky-pale/40"
                    title="Not built yet">
                <%= render "shared/icon", name: item[:icon], class: "size-5 shrink-0" %>
                <%= item[:label] %>
              </span>
            <% end %>
          </li>
        <% end %>
      <% end %>

      <% if current_account&.super_admin? %>
        <% platform_items = [
             { label: "Tenants",  icon: :shield, path: super_admin_tenants_path },
             { label: "Accounts", icon: :user,   path: super_admin_accounts_path }
           ] %>
        <li class="pt-2">
          <div class="px-3 pb-1 text-[10px] font-bold uppercase tracking-widest text-sky/60">Platform</div>
          <ul class="space-y-1">
            <% platform_items.each do |item| %>
              <li>
                <%= link_to item[:path],
                      class: "flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold transition #{current_page?(item[:path]) ? 'bg-brand text-white shadow-sm' : 'hover:bg-white/10 hover:text-white'}" do %>
                  <%= render "shared/icon", name: item[:icon], class: "size-5 shrink-0" %>
                  <%= item[:label] %>
                <% end %>
              </li>
            <% end %>
          </ul>
        </li>
      <% end %>
    </ul>

    <div class="relative mt-auto p-3">
      <div class="rounded-xl bg-navy-deep/80 p-4 backdrop-blur">
        <div class="flex items-center gap-3">
          <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-white/10 text-white">
            <%= render "shared/icon", name: :phone, class: "size-4" %>
          </span>
          <div class="text-sm font-bold text-white">Need Help?</div>
        </div>
        <%# Neutral until Spatial Data Engineering has a support address. %>
        <p class="mt-2 text-xs leading-5 text-sky-pale/70">
          Contact your administrator.
        </p>
      </div>
    </div>
  </nav>
</aside>
