<%#
  Sidebar for the signed-in app shell.

  Only Dashboard and (for super admins) Companies have routes today. The rest
  of the mockup's nav is rendered as inert items rather than links to nowhere,
  so the shape of the product is visible without pretending the pages exist.
%>
<%# Nav follows the workflow diagram's views rather than the visual mockup's
    placeholder list: Customers, Appliances, Inspections, Plumbers, Reports. %>
<% nav_items = [
     { label: "Dashboard", icon: :home, path: dashboard_path },
     { label: "Customers", icon: :building },
     { label: "Appliances", icon: :droplet },
     { label: "Inspections", icon: :calendar },
     { label: "Plumbers", icon: :user },
     { label: "Reports", icon: :document },
     { label: "Settings", icon: :gear }
   ] %>

<aside class="flex h-full w-64 shrink-0 flex-col bg-white">
  <div class="px-5 py-6">
    <%= link_to dashboard_path, class: "block" do %>
      <%= image_tag "backflow-lockup.png", alt: "Backflow", class: "h-11 w-auto" %>
    <% end %>
  </div>

  <nav class="relative mx-3 mb-3 flex flex-1 flex-col overflow-hidden rounded-2xl bg-navy pt-4 text-sky-pale">
    <%= image_tag "wave-hero.png", alt: "",
          class: "pointer-events-none absolute inset-x-0 bottom-0 w-full opacity-25 select-none" %>

    <ul class="relative space-y-1 px-3">
      <% nav_items.each do |item| %>
        <li>
          <% if item[:path] %>
            <% active = current_page?(item[:path]) %>
            <%= link_to item[:path],
                  class: "flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold transition #{active ? 'bg-brand text-white shadow-sm' : 'hover:bg-white/10 hover:text-white'}" do %>
              <%= render "shared/icon", name: item[:icon], class: "size-5 shrink-0" %>
              <%= item[:label] %>
            <% end %>
          <% else %>
            <span class="flex cursor-default items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold text-sky-pale/40"
                  title="Not built yet">
              <%= render "shared/icon", name: item[:icon], class: "size-5 shrink-0" %>
              <%= item[:label] %>
            </span>
          <% end %>
        </li>
      <% end %>

      <% if current_account&.super_admin? %>
        <li class="pt-2">
          <div class="px-3 pb-1 text-[10px] font-bold uppercase tracking-widest text-sky/60">Platform</div>
          <%= link_to super_admin_root_path,
                class: "flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold transition #{current_page?(super_admin_root_path) ? 'bg-brand text-white shadow-sm' : 'hover:bg-white/10 hover:text-white'}" do %>
            <%= render "shared/icon", name: :shield, class: "size-5 shrink-0" %>
            Companies
          <% end %>
        </li>
      <% end %>
    </ul>

    <div class="relative mt-auto p-3">
      <div class="rounded-xl bg-navy-deep/80 p-4 backdrop-blur">
        <div class="flex items-center gap-3">
          <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-white/10 text-white">
            <%= render "shared/icon", name: :phone, class: "size-4" %>
          </span>
          <div class="text-sm font-bold text-white">Need Help?</div>
        </div>
        <p class="mt-2 text-xs leading-5 text-sky-pale/70">
          Contact our support team<br>
          (601) 555-0123<br>
          support@backflowapp.com
        </p>
      </div>
    </div>
  </nav>
</aside>
