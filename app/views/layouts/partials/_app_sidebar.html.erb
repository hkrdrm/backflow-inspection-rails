<%#
  Sidebar for the signed-in app shell, all on navy:

    logo · organization · Overview
    YOUR MODULES   one row per module the organization has; the module you're
                   in expands to list its pages (from TenantModules::Registry)
    ORGANIZATION   Team, Company settings, Billing (not built yet), and for
                   super admins the Platform links
    account        who is signed in, My account (not built yet), log out

  Items without a path render as inert "Not built yet" entries rather than
  links to nowhere. data-nav-item / data-nav-heading mark the top-level
  entries for tests.
%>
<%# The logo always needs somewhere safe to go: a tenant lands on their own
    overview, a super admin with no tenant lands in the back office, and a
    super admin who somehow has neither gets no link rather than a 404. %>
<% logo_path = if current_tenant
                 dashboard_path
               elsif current_account&.super_admin?
                 super_admin_root_path
               end %>
<% row = "flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold transition" %>
<% organization_items = [
     { label: "Team", icon: :users },
     { label: "Company settings", icon: :gear },
     { label: "Billing", icon: :credit_card }
   ] %>

<aside class="relative flex h-full w-64 shrink-0 flex-col overflow-hidden bg-navy text-sky-pale">
  <%= image_tag "contours.svg", alt: "",
        class: "pointer-events-none absolute inset-x-0 bottom-0 h-72 w-full object-cover opacity-20 select-none" %>

  <div class="relative px-5 pb-4 pt-6">
    <% if logo_path %>
      <%= link_to logo_path, class: "block" do %>
        <%= render "shared/logo", tone: :dark %>
      <% end %>
    <% else %>
      <%= render "shared/logo", tone: :dark %>
    <% end %>
  </div>

  <% if current_tenant %>
    <%# A label for now; becomes a switcher when accounts can belong to more
        than one organization. %>
    <div class="relative mx-3 mb-3 flex items-center gap-2 rounded-xl border border-white/15 px-3 py-2.5 text-sm font-semibold text-white">
      <%= render "shared/icon", name: :building, class: "size-5 shrink-0 text-sky" %>
      <span data-organization class="truncate"><%= current_tenant.name %></span>
    </div>
  <% end %>

  <nav class="relative flex-1 overflow-y-auto px-3 pb-3" aria-label="Main">
    <% if current_tenant %>
      <% overview_current = current_page?(dashboard_path) %>
      <%= link_to dashboard_path, data: { nav_item: true }, "aria-current": (overview_current ? "page" : nil),
            class: "#{row} #{overview_current ? 'bg-brand text-white shadow-sm' : 'hover:bg-white/10 hover:text-white'}" do %>
        <%= render "shared/icon", name: :home, class: "size-5 shrink-0" %>
        Overview
      <% end %>

      <% modules = current_tenant.enabled_modules %>
      <% if modules.any? %>
        <div class="mt-3 border-t border-white/10 pt-3">
          <div data-nav-heading class="px-3 pb-2 text-[10px] font-bold uppercase tracking-widest text-sky/70">Your modules</div>
          <ul class="space-y-1">
            <% modules.each do |definition| %>
              <% inside = current_module&.key == definition.key %>
              <li data-module="<%= definition.key %>">
                <%= link_to public_send(definition.home_path), data: { nav_item: true },
                      class: "#{row} #{inside ? 'bg-brand text-white shadow-sm' : 'hover:bg-white/10 hover:text-white'}" do %>
                  <%= render "shared/icon", name: definition.icon, class: "size-5 shrink-0" %>
                  <span class="flex-1"><%= definition.name %></span>
                  <%= render "shared/icon", name: (inside ? :chevron_down : :chevron_right), class: "size-4 shrink-0 opacity-70" %>
                <% end %>

                <% if inside %>
                  <ul data-module-pages class="mb-1 ml-5 mt-1 space-y-0.5 border-l border-white/10 pl-3">
                    <% module_pages(definition).each do |page| %>
                      <li>
                        <%= link_to page[:label], page[:href], "aria-current": (page[:current] ? "page" : nil),
                              class: "relative block rounded-lg px-3 py-1.5 text-sm transition #{page[:current] ? 'font-semibold text-white before:absolute before:-left-[13px] before:top-1.5 before:bottom-1.5 before:w-0.5 before:rounded-full before:bg-brand' : 'text-sky-pale/80 hover:text-white'}" %>
                      </li>
                    <% end %>
                  </ul>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mt-3 border-t border-white/10 pt-3">
        <div data-nav-heading class="px-3 pb-2 text-[10px] font-bold uppercase tracking-widest text-sky/70">Organization</div>
        <ul class="space-y-1">
          <% organization_items.each do |item| %>
            <li>
              <span data-nav-item class="<%= row %> cursor-default text-sky-pale/40" title="Not built yet">
                <%= render "shared/icon", name: item[:icon], class: "size-5 shrink-0" %>
                <%= item[:label] %>
              </span>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <% if current_account&.super_admin? %>
      <% platform_items = [
           { label: "Tenants",  icon: :shield, path: super_admin_tenants_path },
           { label: "Accounts", icon: :user,   path: super_admin_accounts_path },
           { label: "Modules",  icon: :document, path: super_admin_modules_path }
         ] %>
      <div class="mt-3 border-t border-white/10 pt-3">
        <div class="px-3 pb-2 text-[10px] font-bold uppercase tracking-widest text-sky/70">Platform</div>
        <ul class="space-y-1">
          <% platform_items.each do |item| %>
            <li>
              <%= link_to item[:path],
                    class: "#{row} #{current_page?(item[:path]) ? 'bg-brand text-white shadow-sm' : 'hover:bg-white/10 hover:text-white'}" do %>
                <%= render "shared/icon", name: item[:icon], class: "size-5 shrink-0" %>
                <%= item[:label] %>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </nav>

  <% if current_account %>
    <% name = current_account.email.split("@").first %>
    <div data-account class="relative flex items-center gap-3 border-t border-white/10 px-4 py-3">
      <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-brand text-sm font-bold uppercase text-white">
        <%= name.first(2) %>
      </span>
      <div class="min-w-0 flex-1 leading-tight">
        <div class="truncate text-sm font-bold text-white"><%= name.capitalize %></div>
        <span class="cursor-default text-xs text-sky-pale/50" title="Not built yet">My account</span>
      </div>
      <%= button_to rodauth.logout_path, method: :post, title: "Log out",
            class: "cursor-pointer rounded-lg p-1.5 text-sky-pale/70 hover:bg-white/10 hover:text-white",
            form: { data: { turbo: false } } do %>
        <%= render "shared/icon", name: :logout, class: "size-5" %>
        <span class="sr-only">Log out</span>
      <% end %>
    </div>
  <% end %>
</aside>
