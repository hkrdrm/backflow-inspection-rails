<header class="flex items-center justify-between gap-4 border-b border-line bg-white px-4 py-3 lg:px-8">
  <button type="button" class="lg:hidden -ml-1 rounded-lg p-2 text-navy hover:bg-tint"
          data-action="click->mobile-menu#toggle" aria-label="Toggle menu" aria-expanded="false">
    <svg data-mobile-menu-target="openIcon" class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
    </svg>
    <svg data-mobile-menu-target="closeIcon" class="hidden size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

  <div class="ml-auto flex items-center gap-2 sm:gap-4">
    <span class="relative cursor-default rounded-lg p-2 text-navy" title="Alerts — not built yet">
      <%= render "shared/icon", name: :bell, class: "size-5" %>
      <span class="absolute right-1 top-1 flex size-4 items-center justify-center rounded-full bg-brand text-[10px] font-bold text-white">3</span>
    </span>

    <span class="cursor-default rounded-lg p-2 text-navy" title="Help — not built yet">
      <%= render "shared/icon", name: :help, class: "size-5" %>
    </span>

    <div class="h-8 w-px bg-line"></div>

    <div class="flex items-center gap-3">
      <div class="hidden text-right sm:block">
        <div class="text-sm font-bold leading-tight text-navy"><%= current_account.email.split("@").first %></div>
        <div class="text-xs text-muted">
          <%= current_account.super_admin? ? "Platform Operator" : "Property Owner" %>
        </div>
      </div>

      <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-navy text-sm font-bold uppercase text-white">
        <%= current_account.email.first %>
      </span>

      <%= button_to rodauth.logout_path, method: :post,
            class: "rounded-lg p-1.5 text-muted hover:bg-tint hover:text-navy cursor-pointer",
            title: "Log out", form: { data: { turbo: false } } do %>
        <%= render "shared/icon", name: :chevron_down, class: "size-4" %>
      <% end %>
    </div>
  </div>
</header>
