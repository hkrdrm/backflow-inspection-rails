<%#
  Shared frame for every page inside a module: a breadcrumb (home › module ›
  page) above the page. The module's pages themselves are listed in the
  sidebar. Nested inside the app layout.
%>
<% pages = module_pages(current_module) %>
<% current_page = pages.find { |page| page[:current] } %>

<% content_for :content do %>
  <div class="mx-auto max-w-7xl">
    <nav data-breadcrumb aria-label="Breadcrumb" class="mb-4 flex items-center gap-2 text-sm text-muted">
      <%= link_to dashboard_path, class: "hover:text-navy", title: "Overview" do %>
        <%= render "shared/icon", name: :home, class: "size-4" %>
        <span class="sr-only">Overview</span>
      <% end %>
      <span aria-hidden="true">›</span>
      <%= link_to current_module.name, public_send(current_module.home_path), class: "font-semibold hover:text-navy" %>
      <% if current_page %>
        <span aria-hidden="true">›</span>
        <span aria-current="page" class="font-semibold text-navy"><%= current_page[:label] %></span>
      <% end %>
    </nav>

    <%= yield %>
  </div>
<% end %>

<%= render template: "layouts/app" %>
