<%# This tenant's modules, with Remove, and an Add form for the rest. A
    separate card rather than fields in the tenant form: each change is its
    own audited action. %>
<%# Assigned modules include ones disabled platform-wide (still assigned,
    but off); only enabled modules can be added. %>
<% assigned = tenant.assigned_modules %>
<% statuses = PlatformModule.statuses %>
<% available = TenantModules::Registry.all.select { |definition| statuses[definition.key] == "active" } - assigned %>

<section class="mt-6 max-w-xl rounded-2xl border border-line bg-white p-6">
  <h2 class="text-lg font-bold text-navy">Modules</h2>
  <p class="mt-1 text-sm text-navy/70">Removing a module hides it from this tenant. Their data is kept.</p>

  <% if assigned.any? %>
    <ul data-tenant-modules class="mt-4 divide-y divide-line">
      <% assigned.each do |definition| %>
        <li class="flex items-start justify-between gap-4 py-4">
          <div>
            <div class="font-semibold text-navy"><%= definition.name %></div>
            <p class="mt-1 text-xs font-semibold text-ok">
              Enabled since <%= l(tenant.module_enabled_at(definition.key).to_date, format: :long) %>
            </p>
            <% unless statuses[definition.key] == "active" %>
              <p class="mt-1 text-xs font-semibold text-warn-strong">
                <%= SuperAdmin::ModulesController::STATUS_LABELS.fetch(statuses[definition.key]) %> platform-wide: this tenant can't use it until it's enabled again.
              </p>
            <% end %>
          </div>
          <%= button_to "Remove", disable_super_admin_tenant_module_path(tenant, definition.key),
                method: :patch,
                form: { data: { turbo_confirm: "Remove #{definition.name} from #{tenant.name}? Their data is kept and returns if you add it back." } },
                class: "cursor-pointer rounded-lg px-3 py-1.5 text-sm font-semibold text-navy/70 hover:bg-tint hover:text-navy" %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p data-tenant-modules class="mt-4 text-sm text-navy/60">No modules yet.</p>
  <% end %>

  <% if available.any? %>
    <%= form_with url: super_admin_tenant_modules_path(tenant), method: :post,
          data: { add_module: true }, class: "mt-4 flex items-end gap-3 border-t border-line pt-4" do |f| %>
      <div class="flex-1">
        <%= f.label :key, "Add module", class: "block text-sm font-semibold text-navy" %>
        <%= f.select :key, available.map { |definition| [ definition.name, definition.key ] }, {},
              class: "mt-1 w-full rounded-xl border border-line px-3 py-2 focus:border-brand focus:outline-none" %>
      </div>
      <%= f.submit "Add",
            class: "cursor-pointer rounded-xl bg-brand px-5 py-2.5 text-sm font-bold text-white shadow-sm hover:bg-brand-dark" %>
    <% end %>
  <% end %>
</section>
