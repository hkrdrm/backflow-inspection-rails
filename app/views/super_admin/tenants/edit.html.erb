<% @page_title = "Edit #{@tenant.name}" %>

<div class="mx-auto max-w-5xl px-4 py-10">
  <h1 class="text-2xl font-bold tracking-wide uppercase">Edit <%= @tenant.name %></h1>

  <%= render "form", tenant: @tenant, url: super_admin_tenant_path(@tenant),
        method: :patch, submit_label: "Save changes" %>
</div>
