<%= form_with model: account, url: url, method: method,
      class: "mt-6 max-w-xl rounded-2xl border border-line bg-white p-6" do |f| %>
  <% if account.errors.any? %>
    <div class="mb-4 rounded-xl border border-danger/30 bg-danger/10 p-4 text-sm font-semibold text-danger">
      <ul class="list-disc pl-4">
        <% account.errors.each do |field, messages| %>
          <% Array(messages).each do |message| %>
            <li><%= "#{field.to_s.humanize} #{message}" %></li>
          <% end %>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-4">
    <%= f.label :email, "Email", class: "block text-sm font-semibold text-navy" %>
    <%= f.text_field :email,
          class: "mt-1 w-full rounded-xl border border-line px-3 py-2 focus:border-brand focus:outline-none" %>
  </div>

  <div class="mb-4">
    <%= f.label :tenant_id, "Tenant", class: "block text-sm font-semibold text-navy" %>
    <%= f.select :tenant_id, options_for_select(tenant_options, account.tenant_id),
          { include_blank: "No tenant (platform operator)" },
          class: "mt-1 w-full rounded-xl border border-line px-3 py-2 focus:border-brand focus:outline-none" %>
  </div>

  <div class="mb-4">
    <%= f.label :role, "Role", class: "block text-sm font-semibold text-navy" %>
    <%= f.select :role, options_for_select(Account::ROLES.map { |r| [ r.humanize, r ] }, account.role),
          {},
          class: "mt-1 w-full rounded-xl border border-line px-3 py-2 focus:border-brand focus:outline-none" %>
  </div>

  <div class="mb-4">
    <%= f.label :password, "Password", class: "block text-sm font-semibold text-navy" %>
    <%= f.password_field :password, autocomplete: "new-password",
          class: "mt-1 w-full rounded-xl border border-line px-3 py-2 focus:border-brand focus:outline-none" %>
    <p class="mt-1 text-xs text-muted"><%= password_hint %></p>
  </div>

  <div class="flex items-center gap-4">
    <%= f.submit submit_label,
          class: "cursor-pointer rounded-xl bg-brand px-5 py-3 text-sm font-bold text-white shadow-sm hover:bg-brand-dark" %>
    <%= link_to "Cancel", super_admin_accounts_path,
          class: "text-sm font-semibold text-muted hover:text-navy" %>
  </div>
<% end %>
