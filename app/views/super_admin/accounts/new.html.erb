<% @page_title = "New account" %>

<div class="mx-auto max-w-5xl px-4 py-10">
  <h1 class="text-2xl font-bold tracking-wide uppercase">New account</h1>

  <%= render "form", account: @account, url: super_admin_accounts_path,
        method: :post, submit_label: "Create account",
        password_hint: "At least #{SuperAdmin::AccountsController::PASSWORD_MINIMUM_LENGTH} characters. Share it with the user out of band." %>
</div>
