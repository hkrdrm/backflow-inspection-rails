<% @page_title = "Companies" %>

<div class="mx-auto max-w-7xl space-y-6">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-navy">Companies</h1>
      <p class="mt-1 text-sm text-muted">Every tenant on the platform.</p>
    </div>

    <%= link_to new_super_admin_company_path,
          class: "inline-flex shrink-0 items-center gap-2 rounded-xl bg-brand px-5 py-3 text-sm font-bold text-white shadow-sm hover:bg-brand-dark" do %>
      <%= render "shared/icon", name: :plus, class: "size-5" %>
      New company
    <% end %>
  </div>

  <div class="rounded-2xl border border-line bg-white">
    <% if @companies.empty? %>
      <p class="px-5 py-10 text-center text-sm text-muted">No companies yet.</p>
    <% else %>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[720px] text-left text-sm">
          <thead>
            <tr class="text-xs uppercase tracking-wide text-muted">
              <th class="px-5 py-3 font-semibold">Name</th>
              <th class="px-5 py-3 font-semibold">Slug</th>
              <th class="px-5 py-3 font-semibold">Location</th>
              <th class="px-5 py-3 font-semibold">Accounts</th>
              <th class="px-5 py-3 font-semibold">Status</th>
              <th class="px-5 py-3"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody>
            <% @companies.each do |company| %>
              <tr class="border-t border-line">
                <td class="px-5 py-4 font-semibold text-navy"><%= company.name %></td>
                <td class="px-5 py-4 text-muted"><%= company.slug %></td>
                <td class="px-5 py-4 text-navy"><%= [ company.city, company.state ].compact_blank.join(", ") %></td>
                <td class="px-5 py-4 text-navy"><%= @account_counts.fetch(company.id, 0) %></td>
                <td class="px-5 py-4">
                  <% if company.active? %>
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-ok-pale/50 px-3 py-1 text-xs font-semibold text-ok">
                      <%= render "shared/icon", name: :check, class: "size-3.5" %>
                      Active
                    </span>
                  <% else %>
                    <span class="inline-flex items-center rounded-full bg-line px-3 py-1 text-xs font-semibold text-muted">
                      Inactive
                    </span>
                  <% end %>
                </td>
                <td class="px-5 py-4">
                  <div class="flex items-center justify-end gap-2">
                    <%= link_to "Edit", edit_super_admin_company_path(company),
                          class: "rounded-lg px-3 py-1.5 text-sm font-semibold text-brand hover:bg-tint" %>

                    <% if company.active? %>
                      <%= button_to "Deactivate", deactivate_super_admin_company_path(company),
                            method: :patch,
                            class: "cursor-pointer rounded-lg px-3 py-1.5 text-sm font-semibold text-muted hover:bg-tint hover:text-navy" %>
                    <% else %>
                      <%= button_to "Activate", activate_super_admin_company_path(company),
                            method: :patch,
                            class: "cursor-pointer rounded-lg px-3 py-1.5 text-sm font-semibold text-ok hover:bg-ok-pale/40" %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</div>
